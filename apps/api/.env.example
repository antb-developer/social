NODE_ENV=development
PORT=4000

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Accept OTP "123456" for any phone number. For local/dev only — never set
# this in production. Useful before DLT SMS registration is ready.
DEV_OTP_MODE=true

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Superadmin login (POST /api/superadmin/login) — a single fixed
# username+password, unrelated to phone OTP. Defaults below match the
# hardcoded fallback in config/env.ts; override both before deploying
# anywhere reachable. SUPERADMIN_TOKEN_SECRET signs the session token
# issued on login — set a real random value in production.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=Superadmin@123
SUPERADMIN_TOKEN_SECRET=change-me-to-a-random-secret
