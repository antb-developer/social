VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:4000

# Shows an "OTP is 123456" hint and pre-fills it during login. The OTP still
# has to actually be accepted by Supabase — configure test phone numbers in
# supabase/config.toml (auth.sms.test_otp) for local/dev projects.
VITE_DEV_OTP_MODE=true

# Same VAPID key pair as apps/api/.env.example — only the PUBLIC key goes
# here (safe to expose to the browser). Generate with:
# npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
